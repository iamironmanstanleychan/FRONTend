        ["Lead + follower",        "HK$1.0M", "85.10%", "10.00%", "Lead crosses 10%"],
    ],
    widths=[4.2, 2.0, 2.8, 2.8, 5.8],
    highlight_col=2,
    shade_rows=[1]
)

callout_box(
    doc,
    "Structural condition:  dilution is matched to capital received. If Tranche 2 is "
    "at the investor's discretion, it is priced after the pilot and no shares are "
    "issued against it at Tranche 1 close.",
    fill_color="FCE4E4",
    text_color=RED,
    border_color=RED,
    size=9,
    bold=False,
    italic=True
)

section_heading(doc, "Two questions to ask the fund before proposing any structure")

for q in [
    "1.  What is your minimum position size?  —  Determines whether HK$0.5M tranches are available at all.",
    "2.  Would you accept a HK$0.5M tranche now with a pre-agreed price band for a second tranche post-pilot?  —  Determines whether the tranche structure is on the table.",
]:
    p = doc.add_paragraph()
    p.paragraph_format.space_after = Pt(3)
    p.paragraph_format.left_indent = Cm(0.3)
    r = p.add_run(q)
    r.font.size = Pt(8.5)
    r.bold = True

