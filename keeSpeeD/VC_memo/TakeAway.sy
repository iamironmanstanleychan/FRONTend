doc.add_picture(chart3, width=Cm(17.5))
doc.paragraphs[-1].alignment = WD_ALIGN_PARAGRAPH.CENTER

p = doc.add_paragraph()
p.paragraph_format.space_after = Pt(2)
r = p.add_run(
    "Read the chart vertically: at any Series A price, the green line (HK$5.71M seed) "
