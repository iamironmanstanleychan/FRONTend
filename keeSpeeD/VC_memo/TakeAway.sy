    [
        ["A", "HK$5.71M", "14.90%", "HK$134.2M", "20× at midpoint — maximum dilution"],
        ["B", "HK$7.80M", "11.36%", "HK$176.0M", "20× if Series A clears HK$176M"],
        ["C", "HK$9.00M", "10.00%", "HK$200.0M", "20× if Series A clears HK$200M"],
        ["D", "HK$13.42M", "6.93%", "HK$288.4M", "10× at midpoint — founder's opening"],
    ],
    widths=[0.9, 2.6, 2.4, 3.2, 8.2],
    highlight_col=2,
    shade_rows=[0]
)

note = doc.add_paragraph()
note.paragraph_format.space_before = Pt(4)
r = note.add_run(
    "A is the only seed price at which a HK$1.0M cheque returns the fund 20× at the "
    "midpoint. D delivers 10× — fair, but insufficient for a 5% survival fund. Open at "
    "D, land at B or C, refuse A alone."
)
r.italic = True
r.font.size = Pt(8)
r.font.color.rgb = RGBColor(0x59, 0x59, 0x59)

callout_box(
