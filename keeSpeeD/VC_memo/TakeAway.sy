r.font.color.rgb = RGBColor(0x59, 0x59, 0x59)

section_heading(doc, "The 20× Frontier")

chart1 = chart_ladder()
doc.add_picture(chart1, width=Cm(17.5))
doc.paragraphs[-1].alignment = WD_ALIGN_PARAGRAPH.CENTER

section_heading(doc, "The Ladder — Four Seed Prices, Four Different Outcomes")

data_table(
